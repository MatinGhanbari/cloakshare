# ============================================================================
# API-local overrides (optional)
#
# The repo-root .env is the primary configuration file and is loaded FIRST:
#
#     cp .env.example .env          # run from the repo root
#
# This file is loaded afterwards, so any value set here wins. Use it for
# machine-specific overrides (a different database, a different log level, a
# temporary feature toggle) so the shared root file stays untouched.
#
# The full, documented list of every supported variable lives in the root
# .env.example — nothing is API-exclusive, so it is not duplicated here.
#
# For reference, the variables that are most useful to override:
#
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=debug
# CLOAK_MODE=self-hosted
#
# # Development gateway (single origin on :3000)
# DEV_PROXY=true
# DASHBOARD_DEV_PORT=5174
# VIEWER_DEV_PORT=5173
#
# # PostgreSQL
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/cloak
