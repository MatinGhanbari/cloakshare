# ============================================================================
# Scrinium — environment reference
#
#   cp .env.example .env
#
# This root file is the single source of truth for local development: the API,
# the Vite dev servers (apps/web, apps/viewer) and the Astro site all read it.
# The API additionally reads apps/api/.env afterwards, so anything set there
# wins over this file — use that for machine-specific overrides only.
# ============================================================================

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
NODE_ENV=development

# Single origin for the whole app: API + dashboard (/dashboard) + viewer (/v).
PORT=3000
API_URL=http://localhost:3000
VIEWER_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
# Legacy alias for DASHBOARD_URL, kept for backwards compatibility.
# WEB_URL=http://localhost:3000

# CORS origins (comma-separated). In development the request origin is reflected,
# so this is only used in production.
# CORS_ORIGINS=https://cloakshare.dev,https://app.cloakshare.dev

# ----------------------------------------------------------------------------
# Development topology
# ----------------------------------------------------------------------------
# The API reverse-proxies /dashboard and /v to the Vite dev servers below, so
# http://localhost:3000 is the only URL you ever need to open. Only ever active
# when NODE_ENV=development — production always serves the built SPAs from
# apps/api/public. Set to false to open the Vite ports directly instead.
DEV_PROXY=true

# Internal ports of the Vite dev servers. The Vite configs read these values from
# this file — changing the port here is enough, no config edit required.
DASHBOARD_DEV_PORT=5174
VIEWER_DEV_PORT=5173

# The marketing site (apps/site) is a separate deployment and keeps its own port.
SITE_DEV_PORT=4321

# Mode: 'self-hosted' | 'cloud'
CLOAK_MODE=self-hosted

# ----------------------------------------------------------------------------
# Database — PostgreSQL only
# ----------------------------------------------------------------------------
DB_PROVIDER=postgres
# Local Docker (see docker-compose.db.yml):
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/cloak
# Render / Supabase — use the IPv4 CONNECTION POOLER, NOT the direct host.
# The direct host db.<ref>.supabase.co is IPv6-only and Render has no IPv6 egress (ENETUNREACH).
# Note the pooler username is "postgres.<project-ref>", and the region must match your project:
# DATABASE_URL=postgresql://postgres.itonhljghdesknathiuj:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
# (Copy the exact string from Supabase -> Project Settings -> Database -> Connection pooling.)

# Used by docker-compose.yml / docker-compose.db.yml to create the postgres
# container. Must match the password in DATABASE_URL above.
POSTGRES_PASSWORD=your-password

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/renders
# Cloudflare R2 (cloud mode):
# STORAGE_PROVIDER=s3
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=cloak-renders
# Or any S3-compatible endpoint:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx
# S3_BUCKET_NAME=cloak-renders
# S3_FORCE_PATH_STYLE=false

# ----------------------------------------------------------------------------
# Auth — REQUIRED in production (generate with: openssl rand -hex 32)
# ----------------------------------------------------------------------------
SESSION_SECRET=change-me-to-a-random-64-char-string
JWT_SECRET=change-me-to-another-random-64-char-string
CLOAK_SIGNING_SECRET=change-me-to-yet-another-random-string

# Plan given to every newly created account. Defaults to 'scale', which keeps a
# local/self-hosted install fully unlocked. Values: free | starter | growth | scale
# DEFAULT_PLAN=scale

# ----------------------------------------------------------------------------
# Embedded viewer (<cloak-viewer> web component)
# ----------------------------------------------------------------------------
# Comma-separated origins allowed to embed the viewer. Default: *
# EMBED_ALLOWED_ORIGINS=*

# ----------------------------------------------------------------------------
# Document & video rendering
# ----------------------------------------------------------------------------
# PDF rendering shells out to Poppler (pdfinfo + pdftoppm). It is usually on PATH,
# but a winget/scoop install on Windows often lands outside the PATH inherited by
# the API process, which shows up as "spawn pdfinfo ENOENT" and a failed render.
# Point these at the binaries when that happens (forward slashes are fine):
# PDFINFO_PATH=C:/Users/you/AppData/Local/Microsoft/WinGet/Packages/oschwartz10612.Poppler_Microsoft.Winget.Source_8wekyb3d8bbwe/poppler-25.07.0/Library/bin/pdfinfo.exe
# PDFTOPPM_PATH=C:/Users/you/AppData/Local/Microsoft/WinGet/Packages/oschwartz10612.Poppler_Microsoft.Winget.Source_8wekyb3d8bbwe/poppler-25.07.0/Library/bin/pdftoppm.exe

# Video support in self-hosted mode. Needs ffmpeg/ffprobe on PATH, or set the
# two paths below (Linux/Docker defaults shown — adjust for macOS/Windows).
# ENABLE_VIDEO=true
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Office document conversion (requires LibreOffice installed). Point this at the
# `soffice` executable — not `libreoffice`, which is a shell wrapper.
# LIBREOFFICE_PATH=/usr/bin/soffice

# Per-session secure tile streaming budgets.
PAGE_RATE_LIMIT=100
TILE_RATE_LIMIT=800

# ----------------------------------------------------------------------------
# Stripe (cloud mode only)
# ----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_STARTER_PRICE_ID=price_xxx
# STRIPE_GROWTH_PRICE_ID=price_xxx
# STRIPE_SCALE_PRICE_ID=price_xxx
# STRIPE_STARTER_ANNUAL_PRICE_ID=price_xxx
# STRIPE_GROWTH_ANNUAL_PRICE_ID=price_xxx
# STRIPE_SCALE_ANNUAL_PRICE_ID=price_xxx
# STRIPE_LINK_METER_ID=mtr_xxx
# STRIPE_VIEW_METER_ID=mtr_xxx

# ----------------------------------------------------------------------------
# Email (cloud mode only)
# ----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxx
# FROM_EMAIL=noreply@cloakshare.dev

# ----------------------------------------------------------------------------
# Observability & operations
# ----------------------------------------------------------------------------
# Error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

LOG_LEVEL=info

# Automated database backups
# BACKUP_ENABLED=false
# BACKUP_INTERVAL_HOURS=6
# BACKUP_RETAIN_COUNT=5

# Slack notifications
SLACK_SIGNUP_WEBHOOK_URL=

# Admin access (comma-separated emails that get sysadmin endpoints)
# ADMIN_EMAILS=you@example.com

# ----------------------------------------------------------------------------
# Frontend build-time variables (must be prefixed with VITE_)
# Read by apps/web, apps/viewer and apps/site from this file.
# ----------------------------------------------------------------------------
# Leave empty for the single-origin default: same origin in production,
# http://localhost:3000 in development.
# VITE_API_URL=

# PostHog product analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# NOTE: VITE_APP_BASE is NOT set here on purpose — apps/web and apps/viewer need
# different values ('/dashboard/' and '/v/'), so it is only settable per-app on
# the command line. The defaults already match the single-origin deployment.
